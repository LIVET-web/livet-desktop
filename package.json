{
  "name": "livet-desktop",
  "productName": "LIVET Work",
  "version": "1.0.8",
  "description": "LIVET para escritorio: agenda, finanzas, empresa y creadores en una sola app.",
  "main": "main.js",
  "author": "LIVET",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "work.livet.app",
    "productName": "LIVET Work",
    "copyright": "© LIVET",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LIVET-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LIVET"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "LIVET-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraFiles": [
        {
          "from": "build/calread",
          "to": "MacOS/calread"
        }
      ],
      "extendInfo": {
        "NSCalendarsUsageDescription": "LIVET Work muestra los eventos de tu calendario dentro de LIVET.",
        "NSCalendarsFullAccessUsageDescription": "LIVET Work muestra los eventos de tu calendario dentro de LIVET."
      }
    },
    "afterSign": "build/adhoc-sign.js"
  }
}
